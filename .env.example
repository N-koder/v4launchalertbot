# =======================================================
# TELEGRAM CONFIGURATION
# =======================================================
# Get your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Channel ID or Username (e.g. @your_channel_name or -1001234567890)
# Make sure your Bot is added as an Admin in the channel with "Post Messages" permission!
TELEGRAM_CHANNEL_ID=@your_channel_here

# Optional: Your personal Telegram User ID to restrict admin commands (/test, /setref, etc.)
ADMIN_USER_ID=

# =======================================================
# SCANNER & DASHBOARD SETTINGS
# =======================================================
# Poll interval in seconds (default: 2 seconds for sub-second sniper speed)
POLL_INTERVAL_SECONDS=2

# Local Web Dashboard & Preview UI port
PORT=3080

# Enable/Disable specific launchpads (true / false)
ENABLE_PROGRAMMABLE=true
ENABLE_STOCKEREUM=true
ENABLE_SENDER=true
ENABLE_PROGRAMMABLE_ROBINHOOD=true

# =======================================================
# TRADING BOT REFERRAL CODES (Optional - Earn Trading Fees!)
# =======================================================
MAESTRO_REF=
BANANA_REF=
SIGMA_REF=
